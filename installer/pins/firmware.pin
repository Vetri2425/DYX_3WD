# Firmware pin. px4_msgs on the rover MUST be generated from this SHA's msg/ + srv/:
# the firmware modifies EstimatorAidSource3d.msg, so stock px4_msgs silently mismatches
# (spec 4.6, risk R4). Changing FIRMWARE_SHA triggers a px4_msgs rebuild at next upgrade.
FIRMWARE_REPO=https://github.com/Vetri2425/PX4-Autopilot-3WD-Prod.git
FIRMWARE_BRANCH=dyx-3wd-production
FIRMWARE_SHA=27a7ac92845317b0276776242c504215809b2a0f
# px4_msgs repository supplies only the package skeleton (CMakeLists.txt, package.xml);
# its msg/ and srv/ are replaced wholesale by the firmware's. v1.17.0 tag == release/1.17 tip.
PX4_MSGS_REPO=https://github.com/PX4/px4_msgs.git
PX4_MSGS_SKELETON_REF=86d8239e962f6939e05c3737784f60c02fa884db
