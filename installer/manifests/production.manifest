# DYX 3WD production install manifest.
#
# Lists what reaches a production rover. Anything absent here is development-only.
#
# ⛔ dyx3_rpp_legacy is DELIBERATELY ABSENT. It is the quarantined Python shadow
#    oracle (architecture 7.5) and must never ship. CI job `legacy_quarantine`
#    fails the build if it appears in this file.

[ros2_packages]
dyx3_interfaces
dyx3_geometry
dyx3_mission
dyx3_rpp
dyx3_motion_guard
dyx3_px4_link
dyx3_gnss_rtk
dyx3_spray
dyx3_recorder
dyx3_system_gateway
dyx3_bringup

[services]
dyx3-platform
dyx3-ros
dyx3-rtk
dyx3-backend
dyx3-recorder
dyx3-spray-watchdog
dyx3-usb-serial-check

# Implemented in code: all of the above. Only rover services verified on hardware plus the
# idempotent host USB provisioning/verification unit belong in enabled_services. The USB unit
# runs during activation of the new release, including upgrades initiated by an older installer.
# An enabled service that fails health makes
# `dyx3-upgrade` revert. All six verified running on the 3WD rover 2026-10-08 (release 42c065b + the 4bb213a launcher fix):
# platform (agent session, 68 /fmu topics), ros (graph + gateway socket), rtk (NTRIP login, reconnect), spray-watchdog,
# recorder (22 topics), backend (/api/ping 200; bench binds 0.0.0.0 via /etc/dyx3/backend.env until the hotspot exists).
[enabled_services]
dyx3-usb-serial-check
dyx3-platform
dyx3-ros
dyx3-rtk
dyx3-spray-watchdog
dyx3-recorder
dyx3-backend

[filesystem]
/opt/dyx3/{current,releases,bin}
/etc/dyx3
/var/lib/dyx3/{missions,runs,bags,reports,state}
/var/log/dyx3
/run/dyx3
