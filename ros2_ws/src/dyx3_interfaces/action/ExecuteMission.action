# CANONICAL mission-execution interface. Owner: dyx3_mission (single action server).
# Cancel of an active goal is equivalent to AbortMission with REASON_OPERATOR.
# See also srv/StartMission.srv (thin admission-only wrapper over the same code path).
# Goal
string path_artifact_sha256
---
# Result
uint8 RESULT_COMPLETED=0
uint8 RESULT_ABORTED=1
uint8 RESULT_ERROR=2
uint8 result_code
uint32 completed_runs
---
# Feedback
uint32 run_index
uint32 point_index
float32 progress_fraction
uint8 mission_state
