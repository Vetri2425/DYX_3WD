# Template for /etc/dyx3/backend.env — read by dyx3-backend. Auth tokens are NOT here: create them with
#   /opt/dyx3/current/venv/bin/python -m dyx3_backend.auth.tokens create --name tablet-1 --role operator
# (stored hashed in /var/lib/dyx3/state/auth.json). Without a token file every protected route is denied.
#DYX3_BACKEND_HOST=10.42.0.1
#DYX3_BACKEND_PORT=8000
#DYX3_GATEWAY_SOCKET=/run/dyx3/gateway.sock
# Rover identity (docs/contracts/backend.md 1a). Blank = derived from /etc/machine-id and the hostname.
#DYX3_ROVER_ID=
#DYX3_ROVER_NAME=DYX 3WD 01
# LAN discovery beacon: UDP 5003, every network except the FCU link. 0 disables it.
#DYX3_BEACON_ENABLE=1
