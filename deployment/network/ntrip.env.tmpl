# First-boot seed for /etc/dyx3/ntrip.env (root:dyx3 0640). dyx3-rtk imports it only
# when /var/lib/dyx3/rtk/config.json is absent; runtime configuration is authoritative
# thereafter. Never commit real values. Passwords never enter argv, logs or status.
#DYX3_NTRIP_HOST=
#DYX3_NTRIP_PORT=2101
# Required for legacy environment configuration: choose PLAINTEXT or TLS explicitly.
#DYX3_NTRIP_SECURITY=PLAINTEXT
# Optional PEM CA bundle for private TLS casters; system trust is used otherwise.
#DYX3_NTRIP_CA_FILE=
#DYX3_NTRIP_MOUNTPOINT=
#DYX3_NTRIP_USER=
#DYX3_NTRIP_PASSWORD=
