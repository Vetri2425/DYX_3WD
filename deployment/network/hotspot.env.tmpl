# Optional Jetson access point. Set both values to enable it on a Wi-Fi device; set both empty to remove it.
# A file that fails validation never removes a working access point: the installer warns and keeps it.
# Use unquoted ASCII values; do not commit this populated file.
DYX3_HOTSPOT_SSID=
DYX3_HOTSPOT_PSK=
# Country must match the rover's operating location (ISO 3166-1 alpha-2).
DYX3_WIFI_COUNTRY=IN
DYX3_WIFI_BAND=a
# Leave channel blank to use 149 for a (the only 5 GHz AP channel the Jetson RTL8822CE driver allows) or 6 for bg.
DYX3_WIFI_CHANNEL=
DYX3_WIFI_WIDTH=20
# Per-rover access-point address, CIDR. Fleet plan: 192.168.2.100/24 = first 3WD, 192.168.2.101/24 = next
# (never the site router subnet in network.env; the installer refuses that).
# Blank uses 10.42.0.1/24. Tablets get DHCP in the same /24. Set DYX3_BACKEND_HOST in backend.env to match.
DYX3_HOTSPOT_ADDRESS=
# Access-point Wi-Fi device. Blank = the first non-USB Wi-Fi (onboard RTL8822CE); a USB dongle is the
# internet uplink and is never chosen automatically.
DYX3_HOTSPOT_IFACE=
# Cap on hotspot clients' own internet through the rover (all clients together; hashlimit units,
# kb = KiB). It keeps tablet downloads from filling the Wi-Fi queue in front of the app (4WD lesson,
# 2026-09-28). Blank = defaults: 2mb/s down (burst 4mb), 1mb/s up (burst 2mb), txqueuelen 100.
DYX3_HOTSPOT_DOWNLOAD_LIMIT=
DYX3_HOTSPOT_DOWNLOAD_BURST=
DYX3_HOTSPOT_UPLOAD_LIMIT=
DYX3_HOTSPOT_UPLOAD_BURST=
DYX3_HOTSPOT_TXQUEUELEN=
