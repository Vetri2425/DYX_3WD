# Optional Jetson access point. Set both values to enable it on a Wi-Fi device.
# Use unquoted ASCII values; do not commit this populated file.
DYX3_HOTSPOT_SSID=
DYX3_HOTSPOT_PSK=
# Country must match the rover's operating location (ISO 3166-1 alpha-2).
DYX3_WIFI_COUNTRY=IN
DYX3_WIFI_BAND=a
# Leave channel blank to use 36 for a or 6 for bg.
DYX3_WIFI_CHANNEL=
DYX3_WIFI_WIDTH=20
# Per-rover access-point address, CIDR. Fleet plan: 192.168.3.100/24 = first 3WD, 192.168.3.101/24 = next.
# Blank uses 10.42.0.1/24. Tablets get DHCP in the same /24. Set DYX3_BACKEND_HOST in backend.env to match.
DYX3_HOTSPOT_ADDRESS=
# Access-point Wi-Fi device. Blank = the first non-USB Wi-Fi (onboard RTL8822CE); a USB dongle is the
# internet uplink and is never chosen automatically.
DYX3_HOTSPOT_IFACE=
