# Template for /etc/dyx3/platform.env (tracked *.env is forbidden) — read by dyx3-platform. Created once by the installer; never
# overwritten by an upgrade. Fixed addressing comes from the architecture (spec 4.4).
DYX3_FCU_JETSON_IP=10.41.10.1
DYX3_FCU_PX4_IP=10.41.10.2
# Micro XRCE-DDS Agent (data plane). UXRCE_DDS_PRT on the FCU must match.
DYX3_XRCE_PORT=8888
# mavlink-router (service plane: QGC forward). Idle while MAV_2_CONFIG=0 on the FCU.
DYX3_MAVROUTER_CONF=/etc/dyx3/mavlink-router.conf
DYX3_MAVROUTER_ENABLE=1
# Restart backoff for a crashed child, seconds.
DYX3_RESTART_DELAY_S=2
