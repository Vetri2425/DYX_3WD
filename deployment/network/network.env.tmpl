# /etc/dyx3/network.env: per-rover site LAN on the Jetson Ethernet port (shared with the FCU link).
# Created once, never overwritten. Leave blank when no site router is cabled into the rover.
# Pick an address outside the router's DHCP pool, and never the hotspot subnet (hotspot.env).
# Fleet plan 2026-10-09: router 192.168.3.1; rover 01 = 192.168.3.150, rover 02 = .151; hotspots 192.168.2.100/.101.
# Apply after editing:
#   sudo bash -c '. /opt/dyx3/current/installer/lib/common.sh; . /opt/dyx3/current/installer/lib/network_install.sh; install_fcu_network'
DYX3_LAN_ADDRESS=
DYX3_LAN_GATEWAY=
# Bench only: keep DHCP and its default route on the FCU port (a site router behind the FCU switch is the only WAN).
# Production is static-only; leave it unset. An FCU_KEEP_DHCP variable in the installer's environment overrides this.
#FCU_KEEP_DHCP=1
