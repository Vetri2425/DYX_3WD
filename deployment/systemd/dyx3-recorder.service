[Unit]
Description=DYX 3WD — field evidence: bag, ulog, manifest, parameter snapshots
After=dyx3-ros.service
Wants=dyx3-ros.service
# Must keep recording when the backend dies.

[Service]
Type=exec
User=dyx3
Group=dyx3
EnvironmentFile=-/etc/dyx3/ros.env
ExecStart=/opt/dyx3/current/bin/dyx3-recorder
Restart=always
RestartSec=5
# The main PID is recorder_node itself (start-recorder.sh execs it). `mixed`: SIGTERM goes to it alone, so it finalises the
# bag (SIGINT to the bag child's own process group, up to bag_finalize_timeout_s = 10 s), the end-of-run parameter calls and
# summary.json; whatever is still left in the cgroup after it exits is SIGKILLed. With control-group the bag child got
# SIGTERM at the same moment as the recorder and could be killed mid-finalise.
KillMode=mixed
# 10 s bag stop + 2 s SIGTERM grace + end-of-run parameter snapshots + summary.json, with margin.
TimeoutStopSec=30

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/dyx3 /var/log/dyx3 /run/dyx3
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

LimitNOFILE=65536


StandardOutput=journal
StandardError=journal
SyslogIdentifier=dyx3-recorder

[Install]
WantedBy=multi-user.target
