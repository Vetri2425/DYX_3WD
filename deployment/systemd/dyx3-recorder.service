[Unit]
Description=DYX 3WD — field evidence: bag, ulog, manifest, parameter snapshots
After=dyx3-ros.service
Wants=dyx3-ros.service
# Must keep recording when the backend dies.

[Service]
Type=exec
User=dyx3
Group=dyx3
ExecStart=/opt/dyx3/current/bin/dyx3-recorder
Restart=always
RestartSec=5

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/dyx3 /var/log/dyx3 /run/dyx3
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

LimitNOFILE=65536


StandardOutput=journal
StandardError=journal
SyslogIdentifier=dyx3-recorder

[Install]
WantedBy=multi-user.target
