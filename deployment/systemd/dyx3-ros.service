[Unit]
Description=DYX 3WD — the production control graph
After=dyx3-platform.service
Requires=dyx3-platform.service

[Service]
Type=exec
User=dyx3
Group=dyx3
EnvironmentFile=-/etc/dyx3/ros.env
ExecStart=/opt/dyx3/current/bin/dyx3-ros
Restart=always
RestartSec=5

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/dyx3 /var/log/dyx3 /run/dyx3
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

LimitNOFILE=65536
# The launcher and non-control nodes must be scheduled normally. The launch file gives only
# the RPP and motion-guard control executors FIFO priority and CPU affinity.
LimitRTPRIO=99

StandardOutput=journal
StandardError=journal
SyslogIdentifier=dyx3-ros

[Install]
WantedBy=multi-user.target
