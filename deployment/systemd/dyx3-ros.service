[Unit]
Description=DYX 3WD — the production control graph
After=dyx3-platform.service
Requires=dyx3-platform.service

[Service]
Type=exec
User=dyx3
Group=dyx3
ExecStart=/opt/dyx3/current/bin/dyx3-ros
Restart=always
RestartSec=5

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/dyx3 /var/log/dyx3 /run/dyx3
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

LimitNOFILE=65536
# Real-time: the control loop runs at 250 Hz. Pinned core + FIFO priority.
# CPUQuota is deliberately NOT set — it has no effect under SCHED_FIFO.
LimitRTPRIO=99
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=80
CPUAffinity=4

StandardOutput=journal
StandardError=journal
SyslogIdentifier=dyx3-ros

[Install]
WantedBy=multi-user.target
