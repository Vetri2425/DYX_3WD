[Unit]
Description=DYX 3WD — RTK correction source and delivery
After=dyx3-platform.service
Wants=dyx3-platform.service
# Deliberately a SIBLING of the backend, never a child. In PX4_DXP the NTRIP
# client was a child process of rover-server, so any server deploy silently
# dropped the rover to FLOAT with no warning in the app. That defect does not
# survive into this stack.

[Service]
Type=exec
User=dyx3
Group=dyx3
SupplementaryGroups=dialout
EnvironmentFile=-/etc/dyx3/ros.env
EnvironmentFile=-/etc/dyx3/ntrip.env
# ntrip.env is read-only first-boot seed material. Runtime RTK state is under
# /var/lib/dyx3/rtk; keep ReadWritePaths unchanged.
ExecStart=/opt/dyx3/current/bin/dyx3-rtk
Restart=always
RestartSec=5

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/dyx3 /var/log/dyx3 /run/dyx3
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

LimitNOFILE=65536


StandardOutput=journal
StandardError=journal
SyslogIdentifier=dyx3-rtk

[Install]
WantedBy=multi-user.target
